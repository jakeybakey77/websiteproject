# Copy to .env for local development. Do not commit a real .env file.
PORT=4173
GCP_DEMO_MODE=true
SEED_SAMPLE_LEADS=true
GCP_DB_PATH=data/gcp.sqlite
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
# Optional. Bare origin used to make demo referral links absolute (https, or http://localhost).
# Leave unset to return relative links. Request Host headers are never used for this.
# GCP_PUBLIC_ORIGIN=https://your-demo-host.example
